generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
}

model User {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
  email       String           @unique
  name        String           @default("")
  password    String
  createdAt   DateTime         @default(now())
  assessments Assessment[]
  analyses    AnalysisResult[]
  activities  ActivityLog[]
}

model Assessment {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String   @db.ObjectId
  user       User     @relation(fields: [userId], references: [id])
  subject    String   // DSA | DBMS | OS | CN
  score      Int
  total      Int
  correct    Int
  strengths  String[]
  weaknesses String[]
  createdAt  DateTime @default(now())
}

model AnalysisResult {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  userId             String   @db.ObjectId
  user               User     @relation(fields: [userId], references: [id])
  repo               String
  frontendScore      Int
  backendScore       Int
  fullstackScore     Int
  placementScore     Int
  qualityJson        String   // JSON stringified quality object
  skillGapsJson      String   // JSON stringified skill gaps array
  technologiesJson   String   // JSON stringified detected technologies
  aiFeedback         String
  createdAt          DateTime @default(now())
}

model ActivityLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  type      String   // analysis | assessment | recommendation | login
  label     String
  detail    String
  createdAt DateTime @default(now())
}
